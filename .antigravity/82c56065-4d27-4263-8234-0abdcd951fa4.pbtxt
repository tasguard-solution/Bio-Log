    replacement_chunks {
      replacement_content: "import { ArrowLeft, Box, Download, Settings, Share2 } from \'lucide-react\';\nimport { Organism } from \'../types\';\n\ninterface VisualizationScreenProps {\n  organism: Organism;\n  onBack: () => void;\n}\n\nexport function VisualizationScreen({ organism, onBack }: VisualizationScreenProps) {\n  return (\n    <div className=\"flex-1 flex flex-col h-[calc(100vh-89px)] bg-[#1a1a1a] text-white\">\n      {/* Top Bar overlay */}\n      <div className=\"absolute top-[89px] left-0 right-0 p-6 flex justify-between items-start z-10 pointer-events-none\">\n        <div className=\"pointer-events-auto\">\n          <button \n            onClick={onBack}\n            className=\"flex items-center gap-2 px-4 py-2 bg-black/40 hover:bg-black/60 backdrop-blur-md rounded-lg text-sm font-medium transition-colors border border-white/10\"\n          >\n            <ArrowLeft className=\"w-4 h-4\" /> Back to Gallery\n          </button>\n          \n          <div className=\"mt-6 bg-black/40 backdrop-blur-md rounded-xl p-6 border border-white/10 max-w-sm\">\n            <h2 className=\"font-serif text-2xl font-bold mb-1\">{organism.name}</h2>\n            <p className=\"font-mono text-xs text-gray-400 mb-4\">{organism.subtitle}</p>\n            <p className=\"text-sm text-gray-300 leading-relaxed\">\n              Interactive 3D visualization. Use mouse or touch to rotate and zoom. Select specific organelles to view isolated structures.\n            </p>\n          </div>\n        </div>\n        \n        <div className=\"flex flex-col gap-3 pointer-events-auto\">\n           <button className=\"w-12 h-12 rounded-full bg-black/40 hover:bg-black/60 backdrop-blur-md border border-white/10 flex items-center justify-center transition-colors\">\n             <Settings className=\"w-5 h-5\" />\n           </button>\n           <button className=\"w-12 h-12 rounded-full bg-black/40 hover:bg-black/60 backdrop-blur-md border border-white/10 flex items-center justify-center transition-colors\">\n             <Box className=\"w-5 h-5\" />\n           </button>\n           <button className=\"w-12 h-12 rounded-full bg-black/40 hover:bg-black/60 backdrop-blur-md border border-white/10 flex items-center justify-center transition-colors\">\n             <Share2 className=\"w-5 h-5\" />\n           </button>\n           <button className=\"w-12 h-12 rounded-full bg-primary hover:bg-primary-container shadow-lg flex items-center justify-center transition-colors mt-4\">\n             <Download className=\"w-5 h-5\" />\n           </button>\n        </div>\n      </div>\n      \n      {/* 3D Canvas Placeholder */}\n      <div className=\"flex-1 relative flex items-center justify-center overflow-hidden\">\n        <div className=\"absolute inset-0 bg-gradient-to-b from-[#2a2a2a] to-[#111] pointer-events-none\" />\n        {organism.imageUrl ? (\n          <img \n            src={organism.imageUrl} \n            alt={organism.name} \n            className=\"max-w-[80%] max-h-[80%] object-contain drop-shadow-[0_20px_50px_rgba(0,0,0,0.5)] scale-110 cursor-move\" \n          />\n        ) : (\n          <div className=\"text-gray-500 font-mono flex flex-col items-center\">\n            <Box className=\"w-16 h-16 mb-4 opacity-50\" />\n            <p>3D Model Context Not Available for {organism.name}</p>\n          </div>\n        )}\n        \n        {/* Bottom controls */}\n        <div className=\"absolute bottom-8 left-1/2 -translate-x-1/2 bg-black/60 backdrop-blur-md border border-white/10 rounded-full px-6 py-3 flex items-center gap-8 pointer-events-auto\">\n          <div className=\"flex flex-col items-center gap-1 cursor-pointer hover:text-primary transition-colors\">\n            <div className=\"w-6 h-6 rounded border-2 border-current\" />\n            <span className=\"text-[10px] font-mono uppercase tracking-wider\">Wireframe</span>\n          </div>\n          <div className=\"w-px h-8 bg-white/20\" />\n          <div className=\"flex flex-col items-center gap-1 cursor-pointer text-primary transition-colors\">\n             <div className=\"w-6 h-6 rounded bg-current\" />\n            <span className=\"text-[10px] font-mono uppercase tracking-wider\">Solid</span>\n          </div>\n          <div className=\"w-px h-8 bg-white/20\" />\n          <div className=\"flex flex-col items-center gap-1 cursor-pointer hover:text-primary transition-colors\">\n            <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\"><path d=\"M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6\"/></svg>\n            <span className=\"text-[10px] font-mono uppercase tracking-wider\">X-Ray</span>\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n}\n"
    }
