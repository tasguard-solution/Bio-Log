    replacement_chunks {
      replacement_content: "import { Organism } from \'./types\';\n\nexport const ORGANISMS: Organism[] = [\n  {\n    id: \'animal-cell\',\n    name: \'Animal Cell\',\n    subtitle: \'Eukaryotic Cell\',\n    category: \'Animal Cell\',\n    description: \'The basic building block of all animals. It is a eukaryotic cell, meaning it has a membrane-bound nucleus and organelles.\',\n    imageUrl: \'/animal_cell_3d.png\',\n    stats: [\n      { label: \'Size\', value: \'10 - 30 \302\265m\' },\n      { label: \'Shape\', value: \'Varies (mostly round)\' },\n      { label: \'Respiration\', value: \'Aerobic\' },\n    ],\n    details: [\n      {\n        title: \'Mitochondrion\',\n        content: \'Mitochondria have their own DNA, inherited maternally, and are thought to have evolved from ancient bacteria absorbed by early eukaryotic cells.\'\n      }\n    ]\n  },\n  {\n    id: \'bacillus-anthracis\',\n    name: \'Bacillus anthracis\',\n    subtitle: \'Prokaryotic Cell (Bacterium)\',\n    category: \'Bacteria Cell\',\n    description: \'A gram-positive, rod-shaped bacterium that causes anthrax. It is distinguished by its ability to form highly resilient endospores.\',\n    imageUrl: \'/bacteria_cell_3d.png\',\n    stats: [\n      { label: \'Shape\', value: \'Bacillus (Rod)\' },\n      { label: \'Size\', value: \'1-1.2 \303\227 3-5 \302\265m\' },\n      { label: \'Motility\', value: \'Non-motile\' },\n      { label: \'Respiration\', value: \'Facultative anaerobe\' }\n    ],\n    details: [\n      {\n        title: \'WAEC NOTES\',\n        content: \'Bacillus anthracis is the causative agent of anthrax. It is distinguished by its ability to form highly resilient endospores in harsh environmental conditions.\'\n      },\n      {\n        title: \'KEY TAKEAWAYS\',\n        content: \'\342\200\242 Possesses a poly-D-glutamic acid capsule.\\n\342\200\242 Produces anthrax toxin (PA, EF, LF).\\n\342\200\242 Spores can survive in soil for decades.\'\n      }\n    ]\n  },\n  {\n    id: \'fungi\',\n    name: \'Fungi\',\n    subtitle: \'Eukaryotic Kingdom\',\n    category: \'Fungi\',\n    description: \'A kingdom of usually multicellular eukaryotic organisms that are heterotrophs and have important roles in nutrient cycling in an ecosystem. They differ from plants in that they lack chlorophyll and from animals in that they have cell walls.\',\n    imageUrl: \'\', // Fungi view uses grid\n    isFungiGroup: true,\n    stats: [],\n    details: [\n      {\n        title: \'Key Characteristics\',\n        content: \'Eukaryotic Nature: Fungi have membrane-bound nuclei and organelles.\\nChitin Cell Walls: Fungal cell walls are composed primarily of chitin.\\nHeterotrophic Feeding: They absorb nutrients from their environment.\'\n      }\n    ],\n    fungiList: [\n      {\n        id: \'agaricus\',\n        name: \'Agaricus bisporus\',\n        commonName: \'Common Button Mushroom\',\n        description: \'A basidiomycete fungus native to grasslands in Europe and North America.\',\n        type: \'Terrestrial\',\n        imageUrl: \'/fungi_photo.png\'\n      },\n      {\n        id: \'penicillium\',\n        name: \'Penicillium chrysogenum\',\n        commonName: \'Antibiotic-producing Mold\',\n        description: \'A species of fungus in the family Trichocomaceae. It is common in temperate and subtropical regions.\',\n        type: \'Antibiotic\',\n        imageUrl: \'/fungi_photo.png\' // re-use photo for now or generate another\n      },\n      {\n        id: \'saccharomyces\',\n        name: \'Saccharomyces cerevisiae\',\n        commonName: \'Baker\\\'s Yeast\',\n        description: \'A species of yeast (single-celled fungus microorganisms). The species has been instrumental in winemaking, baking, and brewing since ancient times.\',\n        type: \'Budding\',\n        imageUrl: \'/fungi_photo.png\' // re-use photo\n      }\n    ]\n  }\n];\n"
